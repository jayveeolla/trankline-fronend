# Local MariaDB / MySQL connection (server-side only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=shuttle_tracking
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@trackline.local
ADMIN_PASSWORD=change-me

# Optional custom Leaflet tile template. The default uses OpenStreetMap and needs no API key.
VITE_MAP_PROVIDER=osm
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-after-key-rotation
# The frontend uses same-origin /api and Socket.IO through Vite's dev proxy.
# Set VITE_API_URL and VITE_SOCKET_URL only if using a separate API host.
